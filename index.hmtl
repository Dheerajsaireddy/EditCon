<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EditConnect | Skills Meet Opportunities</title>
<meta name="description" content="Prove your skills. Earn recognition. Discover your first professional opportunity.">
<meta name="theme-color" content="#030508">
<link rel="icon" type="image/png" href="assets/favicon.png">
<style>
:root{--bg:#030508;--blue:#126BFF;--neon:#168BFF;--muted:#8fa3bf;--line:rgba(22,139,255,.28);--glass:rgba(10,20,38,.55)}
*{box-sizing:border-box;margin:0}
html{background:var(--bg);color-scheme:dark;scroll-behavior:smooth}
body{color:#fff;font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;overflow-x:hidden}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
h1,h2,h3{line-height:1.15}
ul{margin:12px 0 16px 20px;color:var(--muted)}
[hidden]{display:none!important}
:focus-visible{outline:2px solid var(--neon);outline-offset:3px}
.muted{color:var(--muted)}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
.pg{padding-top:110px;padding-bottom:50px}
.narrow{max-width:600px}
.ptitle{font-size:clamp(1.8rem,5vw,2.6rem);letter-spacing:-.02em;margin-bottom:6px}
.sec{margin:28px 0 6px}
#view>*{animation:fade .5s ease}
@keyframes fade{from{opacity:0;transform:translateY(10px)}}

.lights{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.lights i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;background:radial-gradient(circle,rgba(18,107,255,.16),transparent 65%);animation:drift 24s ease-in-out infinite alternate}
.lights i:first-child{top:-25vmax;left:-15vmax}
.lights i:last-child{bottom:-30vmax;right:-20vmax;animation-delay:-12s}
@keyframes drift{to{transform:translate(6vmax,4vmax)}}

.nav{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:14px clamp(18px,4vw,48px);background:rgba(3,5,8,.72);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(22,139,255,.14)}
.brand{display:flex;align-items:center;gap:10px;font-weight:600;letter-spacing:.02em}
.brand img{height:34px;width:auto}
.menu{display:flex;align-items:center;gap:22px;color:var(--muted);font-size:.92rem}
.menu a{transition:color .25s}
.menu a:hover,.menu a[aria-current]{color:#fff}
.menu .signin{color:#fff;border:1px solid var(--line);padding:8px 18px;border-radius:999px;transition:border-color .25s,box-shadow .25s}
.menu .signin:hover{border-color:var(--neon);box-shadow:0 0 18px rgba(22,139,255,.35)}
.burger{display:none;width:42px;height:42px;background:none;border:1px solid var(--line);border-radius:10px;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:6px}
.burger span{width:18px;height:2px;background:#fff;transition:transform .25s}
.burger[aria-expanded=true] span:first-child{transform:translateY(4px) rotate(45deg)}
.burger[aria-expanded=true] span:last-child{transform:translateY(-4px) rotate(-45deg)}

.hero{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px}
.logo-wrap{position:relative;isolation:isolate;margin-bottom:36px}
.logo-wrap::before{content:"";position:absolute;inset:-35%;z-index:-1;background:radial-gradient(circle,rgba(22,139,255,.32),transparent 62%);animation:pulse 6s ease-in-out infinite}
.logo{width:min(240px,56vw);height:auto;filter:drop-shadow(0 0 26px rgba(22,139,255,.55));animation:float 9s ease-in-out infinite}
@keyframes pulse{50%{opacity:.55;transform:scale(1.06)}}
@keyframes float{50%{transform:translateY(-8px)}}
h1{font-size:clamp(2.4rem,7vw,4.6rem);font-weight:700;letter-spacing:-.03em;max-width:14ch}
.sub{max-width:34em;margin:20px 0 36px;color:var(--muted);font-size:clamp(1rem,2.4vw,1.2rem)}
.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}

.btn{display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border:1px solid var(--line);border-radius:999px;background:transparent;color:#fff;font-family:inherit;font-size:.9rem;font-weight:600;line-height:1;letter-spacing:.12em;cursor:pointer;transition:transform .25s,box-shadow .25s,border-color .25s,background .25s}
.btn:hover{transform:translateY(-2px);border-color:var(--neon)}
.btn:disabled{opacity:.5;cursor:wait}
.btn.primary{background:var(--blue);border-color:transparent;box-shadow:0 0 22px rgba(22,139,255,.45)}
.btn.primary:hover{background:var(--neon);box-shadow:0 0 40px rgba(22,139,255,.8)}
.btn.small{padding:12px 22px;letter-spacing:.04em}
summary{list-style:none;cursor:pointer}
summary::-webkit-details-marker{display:none}
details{margin-top:6px}
details form{margin-top:14px}

.feature{display:block;margin-top:16px;padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:border-color .3s,box-shadow .3s}
a.feature:hover,.feature:hover{border-color:var(--neon);box-shadow:0 0 30px rgba(22,139,255,.18)}
.feature h2,.feature h3{margin:12px 0 8px;letter-spacing:-.01em}
.feature p{color:var(--muted);margin-bottom:8px}
.tag{display:inline-block;margin:0 4px 4px 0;padding:3px 12px;border:1px solid var(--line);border-radius:999px;color:var(--neon);font-size:.78rem}
.hot{color:#fff;background:var(--blue);border-color:transparent}
.meta{font-size:.88rem}
.lead{padding:clamp(32px,6vw,64px);border-color:rgba(22,139,255,.6);box-shadow:0 0 60px rgba(18,107,255,.22),inset 0 0 40px rgba(18,107,255,.08)}
.lead h2{font-size:clamp(1.9rem,5vw,3.1rem);letter-spacing:-.02em}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}
.grid .feature{margin:0}

.panel{width:100%;margin:16px 0;padding:clamp(22px,4vw,36px);border:1px solid var(--line);border-radius:22px;background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.panel h2{margin-bottom:16px;font-size:1.8rem;letter-spacing:-.02em}
fieldset{min-width:0;margin-bottom:18px;padding:0;border:0}
legend{margin-bottom:10px;color:var(--muted);font-size:.85rem}
.roles label{position:relative;display:block;margin-bottom:10px;cursor:pointer}
.roles input{position:absolute;opacity:0}
.roles span{display:block;padding:14px 18px;border:1px solid var(--line);border-radius:14px;transition:border-color .25s,background .25s}
.roles input:checked+span{border-color:var(--neon);background:rgba(18,107,255,.16);box-shadow:0 0 20px rgba(22,139,255,.25)}
.roles input:focus-visible+span{outline:2px solid var(--neon);outline-offset:2px}
.field{display:block;margin-bottom:16px;color:var(--muted);font-size:.85rem}
.field input,.field textarea,.field select{display:block;width:100%;margin-top:6px;padding:13px 16px;border:1px solid var(--line);border-radius:12px;background:rgba(3,5,8,.7);color:#fff;font:inherit}
.field textarea{min-height:90px;resize:vertical}
.field input:focus,.field textarea:focus,.field select:focus{outline:none;border-color:var(--neon);box-shadow:0 0 0 3px rgba(22,139,255,.2)}
.check{display:flex;align-items:center;gap:10px;margin-bottom:16px;color:var(--muted);font-size:.9rem}
.sw{margin-top:18px;font-size:.9rem;color:var(--muted)}
.sw a{color:var(--neon)}

.bar{height:8px;margin:14px 0;border-radius:99px;background:rgba(22,139,255,.15);overflow:hidden}
.bar i{display:block;height:100%;background:var(--neon);box-shadow:0 0 14px var(--neon)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid rgba(22,139,255,.14)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin:18px 0}
.stats div{padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--glass)}
.stats b{display:block;font-size:1.8rem}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:30;max-width:90vw;padding:12px 18px;border:1px solid var(--neon);border-radius:12px;background:#07101f}
.notice{margin:90px 24px -70px;padding:12px 16px;border:1px dashed var(--neon);border-radius:12px;color:var(--neon);font-size:.9rem}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:28px clamp(18px,4vw,48px);border-top:1px solid rgba(22,139,255,.14);color:var(--muted);font-size:.8rem}

@media (max-width:900px){.grid{grid-template-columns:1fr}}
@media (max-width:980px){
  .burger{display:flex}
  .menu{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;padding:8px 18px 18px;background:rgba(3,5,8,.97);border-bottom:1px solid var(--line)}
  .menu.open{display:flex}
  .menu a{padding:14px 4px;border-bottom:1px solid rgba(22,139,255,.1)}
  .menu .signin{margin-top:14px;text-align:center}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>
</head>
<body>
<div class="lights" aria-hidden="true"><i></i><i></i></div>

<header class="nav">
  <a class="brand" href="#/home" aria-label="EditConnect home">
    <img src="assets/logo.png" alt="" onerror="this.hidden=true">
    <span>EditConnect</span>
  </a>
  <button class="burger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu"><span></span><span></span></button>
  <nav class="menu" id="menu" aria-label="Main">
    <a href="#/opps">Opportunities</a>
    <a href="#/first">First Client</a>
    <a href="#/match">Matches</a>
    <a href="#/cert">Certification</a>
    <a href="#/progress">Progress</a>
    <a href="#/profile">Profile</a>
    <a href="#/auth" id="acct" class="signin">Sign in</a>
  </nav>
</header>

<main id="view"></main>

<footer class="foot">
  <span>© 2026 EditConnect</span>
  <span>Early access: accounts and posted projects are real. Certificates and AI features are not live yet.</span>
</footer>
<div id="toast" role="status" hidden></div>

<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import{getAuth,onAuthStateChanged,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut,sendPasswordResetEmail}from"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import{getFirestore,doc,getDoc,setDoc,addDoc,deleteDoc,collection,query,where,orderBy,limit,getDocs,serverTimestamp}from"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* STEP 1: paste your Firebase details between the quotes */
const firebaseConfig={apiKey:"PASTE_API_KEY",authDomain:"PASTE_AUTH_DOMAIN",projectId:"PASTE_PROJECT_ID",appId:"PASTE_APP_ID"};

const live=!Object.values(firebaseConfig).some(v=>v.startsWith("PASTE"));
let auth,db;
if(live){const app=initializeApp(firebaseConfig);auth=getAuth(app);db=getFirestore(app)}

/* ---------- helpers ---------- */
const $=s=>document.querySelector(s),view=$("#view"),menu=$("#menu"),burger=$(".burger");
const R=["Student / Beginner Freelancer","Experienced Freelancer","Client"];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const tags=a=>(a||[]).map(t=>`<span class="tag">${esc(t)}</span>`).join(" ");
const list=s=>[...new Set(s.split(",").map(x=>x.trim()).filter(Boolean))].slice(0,12);
const safe=u=>/^https?:\/\//i.test(u||"")?u:"";
const low=a=>(a||[]).map(x=>x.toLowerCase());
const errs={"auth/invalid-credential":"Wrong email or password.","auth/invalid-email":"That email address is not valid.","auth/email-already-in-use":"That email already has an account. Try signing in.","auth/weak-password":"Use a password with at least 6 characters.","auth/too-many-requests":"Too many attempts. Wait a minute and try again.","auth/network-request-failed":"No internet connection.","permission-denied":"Not allowed. You may have already applied, or the Firestore rules need updating."};
const why=e=>errs[e.code]||e.message||"Something went wrong.";
let me=null,mode="in",busy=false;
const isClient=()=>me?.role==="Client";
const toast=t=>{const e=$("#toast");e.textContent=t;e.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>e.hidden=true,4500)};
const paint=()=>{const a=$("#acct");a.textContent=me?"Sign out":"Sign in";a.href=me?"#/out":"#/auth"};
const page=(t,s,b)=>`<div class="wrap pg"><h2 class="ptitle">${t}</h2><p class="muted">${s}</p>${b}</div>`;
const gate=t=>page(t,"Create a free account or sign in to continue.",`<a class="btn primary" href="#/auth">SIGN IN →</a>`);
const getProjects=async()=>(await getDocs(query(collection(db,"projects"),orderBy("created","desc"),limit(50)))).docs.map(d=>({id:d.id,...d.data()}));

const act=p=>!me?`<a class="btn small" href="#/auth">SIGN IN TO APPLY</a>`:p.owner===me.uid?`<button class="btn small" data-a="del" data-id="${p.id}">DELETE</button>`:isClient()?"":`<details><summary class="btn small">APPLY</summary><form data-f="apply" data-id="${p.id}" data-title="${esc(p.title)}" data-owner="${p.owner}"><label class="field">Note to the client<textarea name="note" maxlength="400" placeholder="Why are you a good fit?"></textarea></label><button class="btn primary small" type="submit">SEND APPLICATION</button></form></details>`;
const card=(p,x="")=>`<article class="feature"><h3>${esc(p.title)}</h3><p class="meta">${p.beginner?'<span class="tag hot">Beginner-friendly</span> ':""}${x?`<span class="tag">${esc(x)}</span>`:""}</p><p>${esc(p.desc)}</p><p class="meta">${tags(p.skills)}</p><p class="meta">By ${esc(p.ownerName)}${p.budget?", budget "+esc(p.budget):""}</p>${act(p)}</article>`;
const postForm=()=>`<details class="panel"><summary class="btn primary small">POST A PROJECT</summary><form data-f="post"><label class="field">Title<input name="title" required maxlength="80"></label><label class="field">Description<textarea name="desc" required maxlength="600"></textarea></label><label class="field">Skills needed (comma separated)<input name="skills" required></label><label class="field">Budget (optional)<input name="budget" maxlength="30"></label><label class="check"><input type="checkbox" name="beginner"> Beginner-friendly (listed in the First Client Programme)</label><button class="btn primary" type="submit">PUBLISH PROJECT</button></form></details>`;

/* ---------- pages ---------- */
const V={
home:()=>`<section class="hero"><div class="logo-wrap"><img class="logo" src="assets/logo.png" alt="EditConnect logo" onerror="this.hidden=true"></div><h1>Skills Meet Opportunities.</h1><p class="sub">Prove your skills. Earn recognition. Discover your first professional opportunity.</p><div class="actions"><a class="btn primary" href="#/${me?"opps":"join"}">START NOW <span aria-hidden="true">→</span></a><a class="btn" href="#/opps">EXPLORE</a></div></section>
<section class="wrap"><a class="feature lead" href="#/first"><span class="tag">Live</span><h2>First Client Programme</h2><p>Help qualified beginners discover genuine client opportunities.</p></a>
<div class="grid"><a class="feature" href="#/cert"><span class="tag">Waitlist open</span><h3>Skill Certification</h3><p>Practical skill assessments and subject-specific platform certificates.</p></a><a class="feature" href="#/progress"><span class="tag">Live</span><h3>Progress Tracking</h3><p>Track your profile, applications and next steps. AI insights are planned.</p></a><a class="feature" href="#/match"><span class="tag">Live</span><h3>Project Matching</h3><p>Projects ranked by the skills you have. AI matching is planned.</p></a></div></section>`,

opps:async()=>{const ps=await getProjects();return page("Opportunities","Projects posted by clients on EditConnect.",(isClient()?postForm():"")+(ps.length?ps.map(p=>card(p)).join(""):'<p class="muted">No projects yet. Clients can post the first one.</p>'))},

first:async()=>{const ps=(await getProjects()).filter(p=>p.beginner);
 const j=!me?`<a class="btn primary" href="#/join">SIGN UP TO JOIN →</a>`:isClient()?'<p class="muted">Tick “Beginner-friendly” when you post a project to list it here.</p>':me.programme?'<span class="tag hot">You are in the programme</span>':'<button class="btn primary" data-a="join">JOIN THE PROGRAMME</button>';
 return page("First Client Programme","Beginner-friendly projects from clients who are open to first-time freelancers.",`<div class="panel">${j}</div>`+(ps.length?ps.map(p=>card(p)).join(""):'<p class="muted">No beginner-friendly projects yet.</p>'))},

match:async()=>{if(!me)return gate("Sign in to see your matches");
 const ps=await getProjects();
 if(isClient()){
  const want=new Set(low(ps.filter(p=>p.owner===me.uid).flatMap(p=>p.skills)));
  if(!want.size)return page("Matches","Post a project and we will suggest freelancers whose skills fit it.","");
  const us=(await getDocs(query(collection(db,"users"),limit(200)))).docs.map(d=>d.data()).filter(u=>u.role!=="Client");
  const r=us.map(u=>({u,n:low(u.skills).filter(s=>want.has(s)).length})).filter(x=>x.n).sort((a,b)=>b.n-a.n);
  return page("Matches","Freelancers whose skills overlap with your projects.",r.length?r.map(({u,n})=>`<article class="feature"><h3>${esc(u.name)}</h3><p class="meta">${tags(u.skills)}</p><p>${esc(u.bio)}</p><p class="meta">${n} matching skill${n>1?"s":""}${safe(u.link)?` · <a href="${esc(safe(u.link))}" target="_blank" rel="noopener">Portfolio</a>`:""}</p></article>`).join(""):'<p class="muted">No matching freelancers yet.</p>')}
 const mine=low(me.skills);
 if(!mine.length)return page("Matches","Add skills to your profile to see projects that fit you.",'<a class="btn primary" href="#/profile">ADD SKILLS</a>');
 const r=ps.filter(p=>p.owner!==me.uid).map(p=>({p,n:low(p.skills).filter(s=>mine.includes(s)).length})).filter(x=>x.n).sort((a,b)=>b.n-a.n);
 return page("Matches","Projects ranked by how many required skills you have. This is skill matching today; AI matching is planned.",r.length?r.map(({p,n})=>card(p,`${n} of ${p.skills.length} skills match`)).join(""):'<p class="muted">No matching projects yet.</p>')},

cert:async()=>{if(!me)return gate("Sign in to join the waitlist");
 const rs=(await getDocs(query(collection(db,"requests"),where("uid","==",me.uid)))).docs.map(d=>d.data());
 return page("Certification","Certificates are not issued yet. Join the waitlist for a skill assessment; requests are saved to your account.",`<form class="panel" data-f="cert"><label class="field">Skill<input name="skill" list="sk" required maxlength="40" placeholder="e.g. Video editing"></label><datalist id="sk">${(me.skills||[]).map(s=>`<option value="${esc(s)}">`).join("")}</datalist><button class="btn primary" type="submit">JOIN WAITLIST</button></form><h3 class="sec">Your requests</h3>`+(rs.length?rs.map(r=>`<div class="row"><span>${esc(r.skill)}</span><span class="tag">On waitlist</span></div>`).join(""):'<p class="muted">No requests yet.</p>'))},

progress:async()=>{if(!me)return gate("Sign in to track your progress");
 const cl=isClient();
 const ck=[["Add your name",!!me.name],["Choose your role",!!me.role],["Write a short bio (20+ characters)",(me.bio||"").length>=20],["Add at least 3 skills",(me.skills||[]).length>=3],["Add a portfolio link",!!safe(me.link)]];
 const pct=Math.round(ck.filter(c=>c[1]).length/ck.length*100);
 const apps=(await getDocs(query(collection(db,"applications"),where(cl?"owner":"applicant","==",me.uid)))).docs.map(d=>d.data());
 const posted=cl?(await getProjects()).filter(p=>p.owner===me.uid).length:0;
 const st=cl?[[posted,"Projects posted"],[apps.length,"Applications received"]]:[[(me.skills||[]).length,"Skills listed"],[apps.length,"Applications sent"],[me.programme?"Yes":"No","In First Client Programme"]];
 const todo=ck.filter(c=>!c[1]).map(c=>`<li>${c[0]}</li>`).join("");
 return page("Progress","Your own activity on EditConnect.",`<div class="panel"><b>Profile ${pct}% complete</b><div class="bar"><i style="width:${pct}%"></i></div>${todo?`<ul>${todo}</ul><a class="btn small" href="#/profile">COMPLETE PROFILE</a>`:'<p class="muted">Your profile is complete.</p>'}</div><div class="stats">${st.map(s=>`<div><b>${s[0]}</b><span class="muted">${s[1]}</span></div>`).join("")}</div><h3 class="sec">${cl?"Applications received":"Your applications"}</h3>`+(apps.length?apps.map(a=>cl?`<div class="row"><span><b>${esc(a.applicantName)}</b> applied to ${esc(a.projectTitle)}<br><span class="muted">${esc(a.note)}</span></span></div>`:`<div class="row"><span>${esc(a.projectTitle)}</span><span class="tag">Sent</span></div>`).join(""):'<p class="muted">Nothing here yet.</p>'))},

profile:()=>!me?gate("Sign in to edit your profile"):page("Profile","Clients and matching use this. Your email is never shown to others.",`<form class="panel" data-f="profile"><label class="field">Full name<input name="name" required maxlength="60" value="${esc(me.name)}"></label><label class="field">I am a<select name="role">${R.map(r=>`<option${r===me.role?" selected":""}>${r}</option>`).join("")}</select></label><label class="field">Short bio<textarea name="bio" maxlength="300">${esc(me.bio)}</textarea></label><label class="field">Skills (comma separated)<input name="skills" value="${esc((me.skills||[]).join(", "))}"></label><label class="field">Portfolio link (https://…)<input name="link" type="url" value="${esc(me.link)}"></label><button class="btn primary" type="submit">SAVE PROFILE</button></form>`),

auth:()=>`<div class="wrap pg narrow"><div class="panel"><h2>${mode==="in"?"Sign in":"Create your account"}</h2><form data-f="auth">${mode==="up"?`<label class="field">Full name<input name="name" required maxlength="60" autocomplete="name"></label><fieldset class="roles"><legend>I am a</legend>${R.map((r,i)=>`<label><input type="radio" name="role" value="${r}"${i?"":" required"}><span>${r}</span></label>`).join("")}</fieldset>`:""}<label class="field">Email<input name="email" type="email" required autocomplete="email"></label><label class="field">Password<input name="password" type="password" required minlength="6" autocomplete="${mode==="in"?"current-password":"new-password"}"></label><button class="btn primary" type="submit">${mode==="in"?"SIGN IN":"CREATE ACCOUNT"}</button></form><p class="sw">${mode==="in"?`New here? <a href="#/auth" data-a="mode">Create an account</a> · <a href="#/auth" data-a="reset">Forgot password?</a>`:`Already have an account? <a href="#/auth" data-a="mode">Sign in</a>`}</p></div></div>`
};

/* ---------- buttons and links ---------- */
const A={
mode:()=>{mode=mode==="in"?"up":"in";view.innerHTML=V.auth()},
reset:async()=>{const m=view.querySelector("[name=email]").value;if(!m)return toast("Type your email first.");await sendPasswordResetEmail(auth,m);toast("Password reset email sent. Check your inbox.")},
del:async b=>{if(!confirm("Delete this project?"))return;await deleteDoc(doc(db,"projects",b.dataset.id));toast("Project deleted.");go()},
join:async()=>{await setDoc(doc(db,"users",me.uid),{programme:true},{merge:true});me.programme=true;toast("You joined the First Client Programme.");go()}
};

/* ---------- forms ---------- */
const F={
auth:async f=>{const d=Object.fromEntries(new FormData(f));
 if(mode==="in"){await signInWithEmailAndPassword(auth,d.email,d.password);return}
 busy=true;
 try{const c=await createUserWithEmailAndPassword(auth,d.email,d.password);
  const p={name:d.name.trim(),role:d.role,bio:"",skills:[],link:"",programme:false};
  me={uid:c.user.uid,email:d.email,...p};paint();
  await setDoc(doc(db,"users",c.user.uid),{...p,created:serverTimestamp()});
  location.hash="#/progress"}
 finally{busy=false}},
post:async f=>{const d=Object.fromEntries(new FormData(f));
 await addDoc(collection(db,"projects"),{owner:me.uid,ownerName:me.name||"Client",title:d.title.trim(),desc:d.desc.trim(),skills:list(d.skills),budget:d.budget.trim(),beginner:!!d.beginner,created:serverTimestamp()});
 toast("Project published.");go()},
apply:async f=>{const d=f.dataset;
 await setDoc(doc(db,"applications",d.id+"_"+me.uid),{project:d.id,projectTitle:d.title,owner:d.owner,applicant:me.uid,applicantName:me.name||"",note:new FormData(f).get("note").trim(),created:serverTimestamp()});
 toast("Application sent.");f.closest("details").open=false},
cert:async f=>{await addDoc(collection(db,"requests"),{uid:me.uid,skill:new FormData(f).get("skill").trim(),created:serverTimestamp()});toast("Added to the waitlist.");go()},
profile:async f=>{const d=Object.fromEntries(new FormData(f));
 const p={name:d.name.trim(),role:d.role,bio:d.bio.trim(),skills:list(d.skills),link:safe(d.link.trim())};
 await setDoc(doc(db,"users",me.uid),p,{merge:true});Object.assign(me,p);toast("Profile saved.")}
};

view.addEventListener("click",async e=>{
 const b=e.target.closest("[data-a]");if(!b)return;
 if(b.tagName==="A")e.preventDefault();
 try{await A[b.dataset.a](b)}catch(x){toast(why(x))}
});
view.addEventListener("submit",async e=>{
 e.preventDefault();
 const f=e.target,b=f.querySelector("[type=submit]");
 b.disabled=true;
 try{await F[f.dataset.f](f)}catch(x){toast(why(x))}
 b.disabled=false;
});

/* ---------- router ---------- */
async function go(){
 let r=location.hash.replace("#/","")||"home";
 if(r==="out"){await signOut(auth);location.hash="#/home";return}
 if(r==="join"){mode="up";r="auth"}else if(r==="auth")mode="in";
 document.querySelectorAll("#menu a").forEach(a=>a.toggleAttribute("aria-current",a.getAttribute("href")==="#/"+r));
 menu.classList.remove("open");burger.setAttribute("aria-expanded","false");
 if(!live&&r!=="home"){view.innerHTML=page("Setup needed","The website is ready, but it is not connected to Firebase yet.","<p>Add your Firebase details at the top of the script, then reload the page.</p>");return}
 view.innerHTML='<p class="muted wrap pg">Loading…</p>';
 try{view.innerHTML=await(V[r]||V.home)()}catch(e){view.innerHTML=page("Something went wrong",esc(why(e)),"")}
 scrollTo(0,0);
}

const load=async u=>{
 me=null;
 if(u){me={uid:u.uid,email:u.email};
  try{const s=await getDoc(doc(db,"users",u.uid));if(s.exists())Object.assign(me,s.data())}catch(e){toast(why(e))}}
 paint();
};

burger.onclick=()=>{const o=menu.classList.toggle("open");burger.setAttribute("aria-expanded",o)};
addEventListener("hashchange",go);
paint();
if(live)onAuthStateChanged(auth,async u=>{if(busy)return;await load(u);if(me&&location.hash==="#/auth")location.hash="#/progress";else go()});
else go();
</script>
</body>
</html>
